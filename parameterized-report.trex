<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.rram.extensions.parameterized-report" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>A dynamic Tableau extension for parameter selection and report refresh functionality with real-time data staleness monitoring.</description>
    <author name="Rahul Ram" email="rahul@rram.dev" organization="RRam" website="https://rram.dev"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>https://localhost:8080/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Parameterized Report Extension</text>
    </resource>
  </resources>
</manifest>